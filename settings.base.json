{
  "autoCompactWindow": 300000,
  "env": {
    "BASH_MAX_OUTPUT_LENGTH": "15000"
  },
  "permissions": {
    "allow": [
      "Bash(graphify query*)",
      "Bash(graphify path*)",
      "Bash(graphify explain*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(bash ~/.claude/skills/review/gate.sh*)",
      "Bash(bash ~/.claude/skills/rules-review/lesson.sh*)",
      "Bash(bash ~/.claude/claude-base-hooks/economy.sh*)"
    ],
    "ask": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(!.env.example)"
    ],
    "deny": [
      "Read(*.pem)",
      "Read(*.key)",
      "Read(id_rsa*)",
      "Read(id_ed25519*)",
      "Read(*.keystore)",
      "Read(~/.ssh/**)",
      "Read(~/.config/solana/**)",
      "Read(~/.foundry/keystores/**)",
      "Read(~/.ethereum/keystore/**)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 30,
            "command": "bash \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/claude-base-hooks/stop-review.sh\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "bash \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/claude-base-hooks/ctx.sh\" guard"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|clear|resume|compact",
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "bash \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/claude-base-hooks/ctx.sh\" start"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/claude-base-hooks/ctx.sh\" status"
  }
}
