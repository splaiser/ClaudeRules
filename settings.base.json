{
  "env": {
    "BASH_MAX_OUTPUT_LENGTH": "15000"
  },
  "permissions": {
    "allow": [
      "Bash(graphify query*)",
      "Bash(graphify path*)",
      "Bash(graphify explain*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Read(*.pem)",
      "Read(*.key)",
      "Read(id_rsa*)",
      "Read(id_ed25519*)",
      "Read(*.keystore)",
      "Read(~/.ssh/**)",
      "Read(~/.config/solana/**)",
      "Read(~/.foundry/keystores/**)",
      "Read(~/.ethereum/keystore/**)"
    ]
  }
}
